# ─── LLM Provider ────────────────────────────────────────────────────────────
# Primary model: used for directive generation, strategy planning, probability estimation
# Use "anthropic/claude-sonnet-4-6" for cloud, "ollama/llama3.1:8b" for local
LLM_PRIMARY_MODEL=anthropic/claude-sonnet-4-6

# Secondary model: used for research extraction, monitor checks, lightweight tasks
# Can be same as primary or a faster/cheaper model
LLM_SECONDARY_MODEL=anthropic/claude-haiku-4-5-20251001

# Cloud API keys (leave blank if using local only)
ANTHROPIC_API_KEY=

# Local Ollama (leave blank if using cloud only)
OLLAMA_BASE_URL=http://localhost:11434

# ─── Database ────────────────────────────────────────────────────────────────
DATABASE_URL=sqlite:///./littleman.db

# ─── Workspace ───────────────────────────────────────────────────────────────
WORKSPACE_DIR=./workspace

# ─── Polymarket ──────────────────────────────────────────────────────────────
POLYMARKET_API_KEY=
POLYMARKET_WALLET_ADDRESS=
# WARNING: private key used only for tx signing; never commit this value
POLYMARKET_PRIVATE_KEY=

# ─── Web search (optional) ────────────────────────────────────────────────────
# Tavily-compatible search API. If unset, web_search degrades to a clear error and the
# agent falls back to browse_url on known sources rather than fabricating results.
SEARCH_API_KEY=
SEARCH_ENDPOINT=https://api.tavily.com/search

# ─── Budget and Risk Limits ───────────────────────────────────────────────────
# Total USDC budget for the agent to work with
BUDGET_USDC=500.00

# Maximum size of a single bet as a fraction of wallet balance (0.20 = 20%)
MAX_POSITION_PCT=0.20

# Maximum total open exposure as a fraction of wallet balance
MAX_EXPOSURE_PCT=0.80

# Maximum loss in a single session before halting new bets for that session
MAX_SESSION_DRAWDOWN_PCT=0.15

# Maximum drawdown from peak balance before entering read-only mode (circuit breaker)
MAX_TOTAL_DRAWDOWN_PCT=0.40

# Maximum exposure to any single topic category
MAX_CATEGORY_EXPOSURE_PCT=0.40

# Minimum edge (probability delta) required before placing a bet (after fee estimate)
MIN_EDGE_PCT=0.03

# Kelly fraction: fraction of full Kelly criterion to use for sizing (0.25 = 25%)
KELLY_FRACTION=0.25

# ─── Scheduler ───────────────────────────────────────────────────────────────
# How often the scheduler polls the heartbeat table (seconds)
HEARTBEAT_POLL_INTERVAL_SECONDS=30

# A heartbeat is considered "missed" if it fires this many minutes late
HEARTBEAT_MISSED_THRESHOLD_MINUTES=10

# If nothing specific is scheduled, create an idle scan after this many hours
IDLE_HEARTBEAT_INTERVAL_HOURS=4
