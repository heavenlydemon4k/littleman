# Copy to .env and fill in. .env is gitignored — never commit it.
# Most of this is also editable live in the UI (Settings → Agent runtime); onboarding sets the
# LLM provider/model for you. These are the defaults / for headless runs.

# ─── LLM provider ─────────────────────────────────────────────────────────────
# "real" calls the LLM via LiteLLM; "fake" uses a deterministic offline provider (tests/dev).
LLM_MODE=real
# Full LiteLLM model strings. Examples:
#   anthropic/claude-sonnet-4-6 · openai/gpt-4o · ollama/llama3.1:8b
#   openai/moonshot-v1-128k (+ LLM_API_BASE below for Kimi/Moonshot or any OpenAI-compatible host)
LLM_PRIMARY_MODEL=anthropic/claude-sonnet-4-6
LLM_SECONDARY_MODEL=anthropic/claude-haiku-4-5-20251001
# Provider-native key (leave blank if using an OpenAI-compatible endpoint below or local Ollama)
ANTHROPIC_API_KEY=
# OpenAI-compatible endpoint override (Kimi/Moonshot, OpenRouter, vLLM, …). Leave blank otherwise.
LLM_API_BASE=
LLM_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

# ─── Database / workspace ─────────────────────────────────────────────────────
DATABASE_URL=sqlite:///./littleman.db
WORKSPACE_DIR=./workspace

# ─── Polymarket (the reference application — optional) ────────────────────────
# Public wallet address enables read-only balance/position reconcile (no spend).
POLYMARKET_WALLET_ADDRESS=
# Private key is only needed for live order signing. NEVER commit it. Leave blank to stay read-only.
POLYMARKET_PRIVATE_KEY=
POLYMARKET_API_KEY=

# ─── Web search (optional) ────────────────────────────────────────────────────
# web_search uses keyless DuckDuckGo by default; set a Tavily key to use Tavily instead.
SEARCH_API_KEY=
SEARCH_ENDPOINT=https://api.tavily.com/search

# ─── Budget and risk limits (the trading application) ─────────────────────────
BUDGET_USDC=500.00
MAX_POSITION_PCT=0.20
MAX_EXPOSURE_PCT=0.80
MAX_SESSION_DRAWDOWN_PCT=0.15
MAX_TOTAL_DRAWDOWN_PCT=0.40
MAX_CATEGORY_EXPOSURE_PCT=0.40
MIN_EDGE_PCT=0.03
KELLY_FRACTION=0.25

# ─── Scheduler ────────────────────────────────────────────────────────────────
HEARTBEAT_POLL_INTERVAL_SECONDS=30
IDLE_HEARTBEAT_INTERVAL_HOURS=4
STALE_SESSION_TIMEOUT_MINUTES=30
